## Tavily Search
TAVILY_API_KEY=tvly-

## Browser Automation
HEADLESS=false
# Optional ScienceDirect overrides (defaults: <repo>/user_data and 15 seconds)
# SCIENCEDIRECT_USER_DATA_DIR=
# SCIENCEDIRECT_MANUAL_WAIT_SECONDS=15
# Reuse a browser you run and log into yourself (e.g. Brave with --remote-debugging-port=9222)
# SCIENCEDIRECT_CDP_URL=http://127.0.0.1:9222

## Email
# Gmail uses an App Password for EMAIL_SECRET.
EMAIL_PROVIDER=gmail
EMAIL_ADDRESS=example@gmail.com
EMAIL_SECRET=your-google-app-password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

## Google Calendar and Drive
# OAuth credentials from a Google Desktop application. Enable both APIs.
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json
GOOGLE_CALENDAR_TIMEZONE=Asia/Jakarta
GOOGLE_DRIVE_DOWNLOAD_PATH=downloads/google-drive
